{
  "name": "closepilot",
  "version": "1.0.0",
  "private": true,
  "description": "Evidence-first commerce revenue close workbench",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:architecture && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "postgres": "^3.4.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "prettier": "3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
